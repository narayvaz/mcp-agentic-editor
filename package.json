{
  "name": "mcp-agentic-editor",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Azat Television",
  "description": "Azat Studio - Native research and automation desktop app",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "build:manifest": "node scripts/create-build-manifest.mjs",
    "build:release": "npm run lint && npm test && npm run build && npm run build:server && npm run build:electron && npm run build:manifest",
    "dev": "npm run desktop:dev",
    "desktop:dev": "npm run build:release && electron .",
    "start": "electron .",
    "build": "vite build",
    "build:server": "tsup server.ts --out-dir dist-server --format esm --clean",
    "build:electron": "tsc -p tsconfig.electron.json && cp electron/preload.cjs dist-electron/preload.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server dist-electron release",
    "lint": "tsc --noEmit",
    "electron:dev": "npm run desktop:dev",
    "electron:build": "npm run build:release && electron-builder",
    "test:agent": "node --import tsx --test tests/agent-*.test.ts"
  },
  "build": {
    "appId": "com.azat.studio",
    "productName": "Azat Studio",
    "artifactName": "Azat-Studio-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build-manifest.json",
        "to": "build-manifest.json"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "dist-electron/**/*",
      "build-manifest.json",
      "package.json",
      "!**/.env*"
    ],
    "mac": {
      "category": "public.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Azat Studio uses your microphone when you start live voice. Your speech is sent to Google Gemini to answer you. End voice to stop microphone access."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "narayvaz",
      "repo": "mcp-agentic-editor"
    }
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.6.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.14",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4"
  }
}
